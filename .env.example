# Exemplo sem segredos. Gere valores reais SOMENTE no servidor.
RBL_MONITOR_DB=/opt/rbl-monitor/data/monitor.db
RBL_MONITOR_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ENABLE_SCHEDULER=1
TZ=America/Sao_Paulo
COOKIE_SECURE=0
TRUST_PROXY=0
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=monitor@example.com
SPAMRATS_API_KEY=
SPAMHAUS_DQS_KEY=
